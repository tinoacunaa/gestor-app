// Esquema Fase 1 — Gestor de Proyectos, Agenda, Cumpleaños y Pagos
// Provider MySQL (Hostinger), igual que tus otros proyectos.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------- Empresas / Multi-empresa ----------

enum RolUsuario {
  SUPER_ADMIN     // crea empresas y sus admins; no ve datos operativos
  ADMIN_EMPRESA   // crea/gestiona usuarios de su empresa; ve todos los datos de su empresa
  USUARIO         // usuario normal de una empresa
}

// Alcance de un registro (proyecto/cita/pago/cumpleaños): privado del usuario
// que lo creó, o compartido y visible para toda la empresa.
enum Visibilidad {
  PRIVADO
  EMPRESA
}

model Empresa {
  id        String   @id @default(cuid())
  nombre    String
  createdAt DateTime @default(now())

  usuarios Usuario[]
}

// ---------- Usuario ----------

model Usuario {
  id        String     @id @default(cuid())
  email     String     @unique
  password  String
  nombre    String?
  rol       RolUsuario @default(USUARIO)
  empresaId String?    // null solo para SUPER_ADMIN
  empresa   Empresa?   @relation(fields: [empresaId], references: [id])
  createdAt DateTime   @default(now())

  proyectos    Proyecto[]
  citas        Cita[]
  cumpleanios  Cumpleanio[]
  pagos        Pago[]

  @@index([empresaId])
}

// ---------- Proyectos ----------

enum EstadoProyecto {
  ACTIVO
  PAUSADO
  COMPLETADO
  CANCELADO
}

enum Periodicidad {
  UNICA
  SEMANAL
  QUINCENAL
  MENSUAL
}

enum TipoSeguimiento {
  ESTADO      // check de 3 posiciones: pendiente / proceso / completado
  PORCENTAJE  // slider 0-100
}

enum EstadoOcurrencia {
  PENDIENTE
  PROCESO
  COMPLETADO
}

model Proyecto {
  id           String         @id @default(cuid())
  nombre       String
  tipo         String?        // etiqueta libre (ej. "Publicidad", "Trámite", "Web")
  fechaInicio  DateTime
  fechaFin     DateTime
  estado       EstadoProyecto @default(ACTIVO)
  usuarioId    String
  usuario      Usuario        @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  empresaId    String?        // empresa del usuario que lo creó (null si el usuario no tiene empresa)
  visibilidad  Visibilidad    @default(PRIVADO)
  actividades  Actividad[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([usuarioId])
  @@index([empresaId])
}

model Actividad {
  id               String            @id @default(cuid())
  proyectoId       String
  proyecto         Proyecto          @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  nombre           String
  descripcion      String?
  duracion         Int?
  unidadDuracion   String?           // "Hora", "Día"
  periodicidad     Periodicidad      @default(UNICA)
  hora             String?           // hora sugerida, formato HH:mm
  fechaInicio      DateTime
  fechaFin         DateTime
  tipoSeguimiento  TipoSeguimiento   @default(ESTADO)

  // Dependencias simples Fin->Inicio (se activa en Fase 2, el campo ya queda listo)
  predecesoraId    String?
  predecesora      Actividad?        @relation("Dependencia", fields: [predecesoraId], references: [id])
  dependientes     Actividad[]       @relation("Dependencia")

  ocurrencias      OcurrenciaActividad[]
  createdAt        DateTime          @default(now())

  @@index([proyectoId])
}

model OcurrenciaActividad {
  id            String           @id @default(cuid())
  actividadId   String
  actividad     Actividad        @relation(fields: [actividadId], references: [id], onDelete: Cascade)
  fecha         DateTime         // inicio del ciclo (ej. el día 19)
  fechaFin      DateTime?        // fin del ciclo (ej. el día 22); null o igual a `fecha` si dura 1 día
  estado        EstadoOcurrencia @default(PENDIENTE)
  porcentaje    Int?             // usado solo si tipoSeguimiento = PORCENTAJE
  nota          String?
  completadoEn  DateTime?

  @@index([actividadId])
  @@index([fecha])
}

// ---------- Agenda / Citas ----------

model Cita {
  id          String   @id @default(cuid())
  titulo      String
  fecha       DateTime
  hora        String?
  lugar       String?
  descripcion String?
  recurrente  Boolean  @default(false)
  usuarioId   String
  usuario     Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  empresaId   String?
  visibilidad Visibilidad @default(PRIVADO)
  createdAt   DateTime @default(now())

  @@index([usuarioId])
  @@index([fecha])
  @@index([empresaId])
}

// ---------- Cumpleaños ----------

model Cumpleanio {
  id        String   @id @default(cuid())
  nombre    String
  fecha     DateTime // se usa día/mes; el año se recalcula en la app
  notas     String?
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  empresaId String?
  visibilidad Visibilidad @default(PRIVADO)
  createdAt DateTime @default(now())

  @@index([usuarioId])
  @@index([empresaId])
}

// ---------- Pagos ----------

enum EstadoPago {
  PENDIENTE
  PAGADO
  VENCIDO
}

model Pago {
  id                String       @id @default(cuid())
  concepto          String
  monto             Float?
  fechaVencimiento  DateTime
  periodicidad      Periodicidad @default(UNICA)
  estado            EstadoPago   @default(PENDIENTE)
  usuarioId         String
  usuario           Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  empresaId         String?
  visibilidad       Visibilidad  @default(PRIVADO)
  createdAt         DateTime     @default(now())

  @@index([usuarioId])
  @@index([fechaVencimiento])
  @@index([empresaId])
}
